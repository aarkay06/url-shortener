{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 60
      }
    }
  ],
  "routes": [
    {
      "src": "^/url/?$",
      "dest": "https://YOUR-FRONTEND-PROJECT.vercel.app"
    },
    {
      "src": "^/url/(.*)$",
      "dest": "https://YOUR-FRONTEND-PROJECT.vercel.app/$1"
    },
    {
      "src": "^/([A-Za-z0-9_-]{8})$",
      "dest": "https://YOUR-API-ID.execute-api.YOUR-REGION.amazonaws.com/$1"
    },
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ]
}
